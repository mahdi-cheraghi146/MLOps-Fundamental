# OneDrive share links for the session packs (filled in by the trainer).
# One link per pack file. Key = SESSION_OS_ARCH. Leave a line empty if there is no pack.
# Windows (WSL2 Ubuntu) uses LINUX_AMD64. Apple Silicon Macs use DARWIN_ARM64.
S02_LINUX_AMD64=
S02_LINUX_ARM64=
S02_DARWIN_ARM64=
S02_DARWIN_AMD64=
